---
import EyeLogo from './EyeLogo.astro';
import { GAMES } from '../lib/games';

interface Props {
  /** Canonical path of the current page, e.g. '/' or '/codes-for-aotr/'. */
  path: string;
}
const { path } = Astro.props;

const normalize = (p: string) => {
  const trimmed = p.replace(/\/+$/, '');
  return trimmed === '' ? '/' : trimmed;
};
const current = normalize(path);

const navItems = [
  ...GAMES.map((game) => ({ label: game.navLabel, href: game.path })),
  { label: 'About', href: '/about/' },
];
---
<header class="site-header">
  <div class="container site-header-inner">
    <a class="brand" href="/" aria-label="rbxeyes home">
      <span class="brand-mark"><EyeLogo size={26} /></span>
      <span class="brand-word">rbx<em>eyes</em><span class="tld">.com</span></span>
    </a>
    <nav class="site-nav" aria-label="Site">
      {navItems.map((item) => (
        <a href={item.href} aria-current={normalize(item.href) === current ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

---
import type { GameRecord } from '../lib/games';
import { formatDate, formatDateRange } from '../lib/format';

interface Props {
  game: GameRecord;
}
const { game } = Astro.props;
const sourceDates = game.sources.map((source) => source.updated);
---
<ul class="source-list">
  {game.sources.map((source) => (
    <li>
      <a class="sname" href={source.url} target="_blank" rel="noopener noreferrer">{source.name}</a>
      <span class="sdate">
        {source.dateKind === 'published' ? 'published' : 'updated'} {formatDate(source.updated)}
      </span>
    </li>
  ))}
</ul>
<p class="read-note">
  We last read every source above on {formatDate(game.lastChecked)} (source pages themselves
  date from {formatDateRange(sourceDates)}). Codes change quickly — a source can lag behind the game.
</p>
{game.sourceNote && (
  <div class="callout">
    <p class="callout-title">Source notes</p>
    <p>{game.sourceNote}</p>
  </div>
)}

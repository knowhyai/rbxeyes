# Canonical origin of the site. Used for canonical URLs, Open Graph URLs,
# the sitemap and robots.txt. Defaults to https://rbxeyes.com when unset.
SITE_URL=https://rbxeyes.com

# --- Google AdSense (all optional; currently unset: the build emits no ad
# --- script, no ad units, and a comment-only ads.txt) ---
# Real AdSense publisher id only: "pub-1234567890123456" or
# "ca-pub-1234567890123456" (10–20 digits). Invalid values are ignored with
# a build-time warning — never invent or guess an id.
# PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# Ad unit slot ids (8–20 digits) for the two placements: after the
# active-codes section and after the how-to-redeem section.
# PUBLIC_ADSENSE_SLOT_TOP=0000000000
# PUBLIC_ADSENSE_SLOT_BOTTOM=0000000000
